          "incident_log",
          "incident_counter",
          "notification_log",
          "push_subscription",
          "agent_rule_state",
          "audit_event"
        ],
        "note": "Monitoring instances trigger incidents, notification logs, push subscriptions, and audit events."
      }
    ]
