  "cards": [
    {
      "dot": "emerald",
      "title": "All Live Feeds Flow to source_event_stream",
      "items": [
        "1. Every live event (triggered or not) is recorded in `source_event_stream`.",
        "2. Events link directly to `person_id` (FK) and `queue_id` (FK), capturing full operational context.",
        "3. Live floor KPIs on the Console Tab are computed directly from this continuous ingestion stream."
      ]
    },
    {
      "dot": "cyan",
      "title": "Team & Queue Organizational Hierarchy",
      "items": [
        "1. `team` anchors the organizational tree (`Tower -> SubTower -> LOB -> Team -> TL -> Mgr`).",
        "2. `queue_map` links contact center queues to their responsible team via `team_id` FK.",
        "3. `person` belongs to a `team` via `team_id` FK, mapping agents and supervisors to their hierarchy."
      ]
    },
    {
      "dot": "violet",
      "title": "Every Instance Notifies (Nudge, Toast, Incident)",
      "items": [
        "1. **Every Broken Rule Fires:** Strike 1 sends a Pop-up Nudge; Strike 2 sends a Toast Alert to the TL.",
        "2. **Ops Escalations:** Strike 3 creates a formal record in `incident_log` for investigative dashboard actions.",
        "3. **Audit History:** Every dispatch is recorded in `notification_log` across Toast, Popup, and Email channels."
      ]
    }
  ]
