{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "RTM Console — Ideal PostgreSQL Schema (22 tables)",
    "locale": "en",
    "output": ".archify/rtm-ideal-erd.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "word-file-core",
        "label": "The Word file's six tables",
        "focus": ["source_event_stream", "rules_master", "notification_route", "monitoring_instance", "notification_log", "incident_log"],
        "note": "Event → Rule → Instance → Route → Notification → Incident, under the same names as RTM Dashboard Data Tables."
      },
      {
        "id": "scoped-thresholds",
        "label": "Thresholds by Tower, Sub-tower, LOB",
        "focus": ["rules_master", "rule_version", "rule_override", "queue_lob_map", "queue", "monitoring_instance"],
        "note": "rule_override sets a rule per Tower, Sub-tower or LOB over the rule_version default; the most specific value wins."
      },
      {
        "id": "queue-mapping",
        "label": "Queues and the Queue-to-LOB mapping",
        "focus": ["genesys_region", "genesys_org", "queue", "queue_member", "queue_lob_map", "team", "person"],
        "note": "The uploaded Queue-to-LOB mapping gives each queue its Tower, Sub-tower and LOB; queue joins it on name_key = queue_key."
      },
      {
        "id": "day-and-strikes",
        "label": "The day, strikes and incidents",
        "focus": ["shift", "agent_rule_state", "monitoring_instance", "incident_log", "incident_counter", "notification_log", "push_subscription"],
        "note": "One shift per org per Eastern day; strikes per shift; every strike from 3 opens its own incident, numbered per year."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "gapX": 56,
    "gapY": 36,
    "entityW": 270
  },
  "entities": [
    {
      "id": "genesys_region", "label": "genesys_region", "sublabel": "Phase 0 · built", "tag": "genesys and queues", "row": 3, "col": 0,
      "attributes": [
        { "name": "region_id", "type": "text", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "api_host", "type": "text" },
        { "name": "login_host", "type": "text" }
      ]
    },
    {
      "id": "genesys_org", "label": "genesys_org", "sublabel": "Phase 0 · built", "tag": "genesys and queues", "row": 2, "col": 0,
      "attributes": [
        { "name": "org_id", "type": "text", "key": "pk" },
        { "name": "region_id", "type": "text", "key": "fk", "references": "genesys_region.region_id" },
        { "name": "name", "type": "text" },
        { "name": "genesys_org_id", "type": "text", "key": "uk" },
        { "name": "view_config_id", "type": "text" },
        { "name": "oauth_client_id", "type": "text" },
        { "name": "enabled", "type": "boolean" }
      ]
    },
    {
      "id": "queue", "label": "queue", "width": 320, "sublabel": "Phase 1", "tag": "genesys and queues", "row": 0, "col": 0,
      "attributes": [
        { "name": "queue_id", "type": "text", "key": "pk" },
        { "name": "org_id", "type": "text", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "name", "type": "text" },
        { "name": "name_key", "type": "text generated upper(trim(name))" },
        { "name": "division", "type": "text" },
        { "name": "queue_group", "type": "text generated" },
        { "name": "queue_subgroup", "type": "text generated" },
        { "name": "watched", "type": "boolean" },
        { "name": "team_id", "type": "text", "key": "fk", "references": "team.team_id" },
        { "name": "seen_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "queue_member", "label": "queue_member", "sublabel": "Phase 1", "tag": "genesys and queues", "row": 4, "col": 0,
      "attributes": [
        { "name": "queue_id", "type": "text", "key": ["pk", "fk"], "references": "queue.queue_id" },
        { "name": "person_id", "type": "text", "key": ["pk", "fk"], "references": "person.person_id" }
      ]
    },
    {
      "id": "queue_lob_map", "label": "queue_lob_map", "sublabel": "Phase 1 · new: Queue-to-LOB mapping upload", "tag": "genesys and queues", "row": 1, "col": 0,
      "attributes": [
        { "name": "queue_key", "type": "text upper(trim(queue))", "key": "pk" },
        { "name": "queue_name", "type": "text" },
        { "name": "tower", "type": "text" },
        { "name": "sub_tower", "type": "text" },
        { "name": "lob", "type": "text" },
        { "name": "region", "type": "text" },
        { "name": "org", "type": "text" },
        { "name": "org_id", "type": "text null = every org", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "uploaded_by", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "uploaded_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "person", "label": "person", "width": 330, "sublabel": "Phase 1 · Genesys user ID", "tag": "people and the day", "row": 0, "col": 1,
      "attributes": [
        { "name": "person_id", "type": "text", "key": "pk" },
        { "name": "org_id", "type": "text", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "team_id", "type": "text", "key": "fk", "references": "team.team_id" },
        { "name": "name", "type": "text" },
        { "name": "email", "type": "text" },
        { "name": "role", "type": "text admin|senior|mgr|tl|agent" },
        { "name": "account_state", "type": "text active|inactive|deleted" },
        { "name": "last_login_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "team", "label": "team", "sublabel": "Phase 1 · hierarchy via its queue", "tag": "people and the day", "row": 1, "col": 1,
      "attributes": [
        { "name": "team_id", "type": "text", "key": "pk" },
        { "name": "org_id", "type": "text", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "name", "type": "text" },
        { "name": "tl_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "manager_id", "type": "text", "key": "fk", "references": "person.person_id" }
      ]
    },
    {
      "id": "push_subscription", "label": "push_subscription", "sublabel": "Phase 1", "tag": "people and the day", "row": 4, "col": 1,
      "attributes": [
        { "name": "endpoint_hash", "type": "text sha256", "key": "pk" },
        { "name": "person_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "endpoint", "type": "text" },
        { "name": "p256dh", "type": "text" },
        { "name": "auth", "type": "text" },
        { "name": "user_agent", "type": "text" },
        { "name": "created_at", "type": "timestamptz" },
        { "name": "last_success_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "shift", "label": "shift", "width": 280, "sublabel": "Phase 2 · one per org per Eastern day", "tag": "people and the day", "row": 2, "col": 1,
      "attributes": [
        { "name": "shift_id", "type": "text", "key": "pk" },
        { "name": "org_id", "type": "text unique with shift_date", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "shift_date", "type": "date (Eastern)" },
        { "name": "starts_at", "type": "timestamptz" },
        { "name": "ends_at", "type": "timestamptz" },
        { "name": "source", "type": "text gencloud|sim" },
        { "name": "status", "type": "text active|closed" },
        { "name": "floor_fired", "type": "text[] rule@group" }
      ]
    },
    {
      "id": "agent_rule_state", "label": "agent_rule_state", "sublabel": "Phase 2 · strikes only", "tag": "people and the day", "row": 3, "col": 1,
      "attributes": [
        { "name": "shift_id", "type": "text", "key": ["pk", "fk"], "references": "shift.shift_id" },
        { "name": "person_id", "type": "text", "key": ["pk", "fk"], "references": "person.person_id" },
        { "name": "rule_id", "type": "text", "key": ["pk", "fk"], "references": "rules_master.rule_id" },
        { "name": "strikes", "type": "smallint" }
      ]
    },
    {
      "id": "monitoring_instance", "label": "monitoring_instance", "width": 310, "sublabel": "Phase 2 · Word file core · one per call-out", "tag": "call-outs and incidents", "row": 0, "col": 3,
      "attributes": [
        { "name": "instance_id", "type": "bigint identity", "key": "pk" },
        { "name": "shift_id", "type": "text", "key": "fk", "references": "shift.shift_id" },
        { "name": "source", "type": "text gencloud|sim" },
        { "name": "rule_id", "type": "text", "key": "fk", "references": "rule_version.rule_id" },
        { "name": "rule_version", "type": "integer", "key": "fk", "references": "rule_version.version" },
        { "name": "rule_override_id", "type": "bigint null = default", "key": "fk", "references": "rule_override.override_id" },
        { "name": "person_id", "type": "text null = floor", "key": "fk", "references": "person.person_id" },
        { "name": "team_id", "type": "text at fire time", "key": "fk", "references": "team.team_id" },
        { "name": "tower", "type": "text at fire time" },
        { "name": "sub_tower", "type": "text at fire time" },
        { "name": "lob", "type": "text at fire time" },
        { "name": "metric_value", "type": "text as shown" },
        { "name": "threshold_value", "type": "numeric" },
        { "name": "condition_text", "type": "text" },
        { "name": "severity", "type": "text warn|crit|esc" },
        { "name": "occurrence_count", "type": "smallint 0 = floor" },
        { "name": "notification_level", "type": "text nudge|lead|ops" },
        { "name": "status", "type": "text open|acked" },
        { "name": "acknowledged_by", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "acknowledged_at", "type": "timestamptz" },
        { "name": "ack_via", "type": "text console|push|ack_all" },
        { "name": "agent_comment", "type": "text ≤ 140" },
        { "name": "agent_comment_at", "type": "timestamptz" },
        { "name": "source_event_id", "type": "bigint no FK" },
        { "name": "created_at", "type": "timestamptz" },
        { "name": "updated_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "incident_log", "label": "incident_log", "width": 330, "sublabel": "Phase 2 · Word file core · one per strike ≥ 3", "tag": "call-outs and incidents", "row": 1, "col": 3,
      "attributes": [
        { "name": "incident_id", "type": "bigint identity", "key": "pk" },
        { "name": "incident_number", "type": "text INC-YYYY-NNNN", "key": "uk" },
        { "name": "instance_id", "type": "bigint", "key": ["fk", "uk"], "references": "monitoring_instance.instance_id" },
        { "name": "shift_id", "type": "text", "key": "fk", "references": "shift.shift_id" },
        { "name": "source", "type": "text gencloud|sim" },
        { "name": "person_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "team_id", "type": "text", "key": "fk", "references": "team.team_id" },
        { "name": "rule_id", "type": "text", "key": "fk", "references": "rules_master.rule_id" },
        { "name": "strike", "type": "smallint ≥ 3" },
        { "name": "tower", "type": "text" },
        { "name": "sub_tower", "type": "text" },
        { "name": "lob", "type": "text" },
        { "name": "status", "type": "text Open|Investigating|Closed" },
        { "name": "disposition", "type": "text one of 12 DISPOSITIONS" },
        { "name": "owner_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "priority", "type": "text" },
        { "name": "root_cause", "type": "text" },
        { "name": "resolution", "type": "text" },
        { "name": "comments", "type": "text" },
        { "name": "opened_at", "type": "timestamptz" },
        { "name": "closed_at", "type": "timestamptz" },
        { "name": "modified_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "incident_counter", "label": "incident_counter", "sublabel": "Phase 2 · one for every org", "tag": "call-outs and incidents", "row": 3, "col": 3,
      "attributes": [
        { "name": "year", "type": "smallint (Eastern)", "key": "pk" },
        { "name": "last_value", "type": "integer" }
      ]
    },
    {
      "id": "notification_log", "label": "notification_log", "width": 340, "sublabel": "Phase 2 · Word file core · monthly partitions", "tag": "call-outs and incidents", "row": 2, "col": 3,
      "attributes": [
        { "name": "notification_log_id", "type": "bigint identity", "key": "pk" },
        { "name": "notification_ts", "type": "timestamptz partition key", "key": "pk" },
        { "name": "instance_id", "type": "bigint null = feed notice", "key": "fk", "references": "monitoring_instance.instance_id" },
        { "name": "recipient_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "recipient_role", "type": "text" },
        { "name": "channel", "type": "text popup|toast|push|…" },
        { "name": "notification_level", "type": "text nudge|lead|ops|info" },
        { "name": "endpoint_hash", "type": "text", "key": "fk", "references": "push_subscription.endpoint_hash" },
        { "name": "delivery_status", "type": "text 6 delivery states" },
        { "name": "action", "type": "text got_it|send_reason|acknowledge" },
        { "name": "action_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "rules_master", "label": "rules_master", "width": 370, "sublabel": "Phase 0 · built · Word file core", "tag": "rules and routes", "row": 1, "col": 2,
      "attributes": [
        { "name": "rule_id", "type": "text", "key": "pk" },
        { "name": "rule_name", "type": "text" },
        { "name": "description", "type": "text" },
        { "name": "rule_type", "type": "text duration|event|ratio|queue|system" },
        { "name": "rule_scope", "type": "text agent|floor" },
        { "name": "metric_name", "type": "text" },
        { "name": "operator", "type": "text > >= < <=" },
        { "name": "once_per_shift", "type": "boolean" },
        { "name": "nudge_template", "type": "text" },
        { "name": "current_version", "type": "integer deferred FK", "key": "fk", "references": "rule_version.version" },
        { "name": "created_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "rule_version", "label": "rule_version", "sublabel": "Phase 0 · built · the default settings", "tag": "rules and routes", "row": 2, "col": 2,
      "attributes": [
        { "name": "rule_id", "type": "text", "key": ["pk", "fk"], "references": "rules_master.rule_id" },
        { "name": "version", "type": "integer", "key": "pk" },
        { "name": "threshold", "type": "numeric ≥ 1" },
        { "name": "unit", "type": "text s|%|calls" },
        { "name": "severity", "type": "text warn|crit" },
        { "name": "route_id", "type": "text", "key": "fk", "references": "notification_route.route_id" },
        { "name": "enabled", "type": "boolean" },
        { "name": "changed_by", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "changed_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "rule_override", "label": "rule_override", "width": 350, "sublabel": "Phase 2 · new: Tower / Sub-tower / LOB settings", "tag": "rules and routes", "row": 0, "col": 2,
      "attributes": [
        { "name": "override_id", "type": "bigint identity", "key": "pk" },
        { "name": "rule_id", "type": "text", "key": "fk", "references": "rules_master.rule_id" },
        { "name": "tower", "type": "text" },
        { "name": "sub_tower", "type": "text '' above its level" },
        { "name": "lob", "type": "text '' above its level" },
        { "name": "scope_level", "type": "text generated tower|sub_tower|lob" },
        { "name": "version", "type": "integer unique per rule + place" },
        { "name": "threshold", "type": "numeric null = inherit" },
        { "name": "severity", "type": "text null = inherit" },
        { "name": "route_id", "type": "text null = inherit", "key": "fk", "references": "notification_route.route_id" },
        { "name": "enabled", "type": "boolean null = inherit" },
        { "name": "change_reason", "type": "text" },
        { "name": "changed_by", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "changed_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "notification_route", "label": "notification_route", "width": 330, "sublabel": "Phase 0 · built · Word file core", "tag": "rules and routes", "row": 3, "col": 2,
      "attributes": [
        { "name": "route_id", "type": "text nudge|lead|nudgeonly|leadonly", "key": "pk" },
        { "name": "route_name", "type": "text" },
        { "name": "description", "type": "text" },
        { "name": "enabled", "type": "boolean" }
      ]
    },
    {
      "id": "notification_route_step", "label": "notification_route_step", "width": 340, "sublabel": "Phase 0 · built · the RouteMap rungs", "tag": "rules and routes", "row": 4, "col": 2,
      "attributes": [
        { "name": "route_id", "type": "text", "key": ["pk", "fk"], "references": "notification_route.route_id" },
        { "name": "step_no", "type": "smallint", "key": "pk" },
        { "name": "min_occurrence", "type": "smallint" },
        { "name": "max_occurrence", "type": "smallint null = and later" },
        { "name": "stage", "type": "text nudge|lead|ops" },
        { "name": "recipient_roles", "type": "text[]" },
        { "name": "action_owner", "type": "text" },
        { "name": "action", "type": "text" },
        { "name": "channels", "type": "text[]" },
        { "name": "opens_incident", "type": "boolean" }
      ]
    },
    {
      "id": "source_event_stream", "label": "source_event_stream", "width": 340, "sublabel": "Phase 3 · Word file core · today only", "tag": "raw events", "row": 4, "col": 3,
      "attributes": [
        { "name": "event_id", "type": "bigint identity", "key": "pk" },
        { "name": "org_id", "type": "text null for NICE / UiPath", "key": "fk", "references": "genesys_org.org_id" },
        { "name": "event_ts", "type": "timestamptz" },
        { "name": "source_system", "type": "text GenCloud|NICE|UiPath" },
        { "name": "entity_type", "type": "text agent|queue|team|lob|system" },
        { "name": "entity_id", "type": "text" },
        { "name": "metric_name", "type": "text" },
        { "name": "metric_value", "type": "text" },
        { "name": "event_payload", "type": "jsonb" },
        { "name": "processed_flag", "type": "boolean" },
        { "name": "processed_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "status_mapping", "label": "status_mapping", "width": 300, "sublabel": "Phase 0 · built", "tag": "raw events", "row": 5, "col": 3,
      "attributes": [
        { "name": "priority", "type": "smallint", "key": "pk" },
        { "name": "signal", "type": "text presence|routing|call" },
        { "name": "genesys_status", "type": "text unique with signal" },
        { "name": "console_state", "type": "text one of 7 states" },
        { "name": "updated_by", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "updated_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "audit_event", "label": "audit_event", "sublabel": "Phase 0 · built", "tag": "audit", "row": 6, "col": 3,
      "attributes": [
        { "name": "audit_id", "type": "bigint identity", "key": "pk" },
        { "name": "at", "type": "timestamptz" },
        { "name": "actor_id", "type": "text", "key": "fk", "references": "person.person_id" },
        { "name": "action", "type": "text" },
        { "name": "target_type", "type": "text" },
        { "name": "target_id", "type": "text" },
        { "name": "before", "type": "jsonb" },
        { "name": "after", "type": "jsonb" }
      ]
    }
  ],
  "relationships": [
    { "id": "org-region", "from": "genesys_org", "to": "genesys_region", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "queue-org", "from": "queue", "to": "genesys_org", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "queue-team", "from": "queue", "to": "team", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "member-queue", "from": "queue_member", "to": "queue", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one" },
    { "id": "member-person", "from": "queue_member", "to": "person", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one" },
    { "id": "map-org", "from": "queue_lob_map", "to": "genesys_org", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "map-uploader", "from": "queue_lob_map", "to": "person", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "person-org", "from": "person", "to": "genesys_org", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "person-team", "from": "person", "to": "team", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "team-org", "from": "team", "to": "genesys_org", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "team-leaders", "from": "team", "to": "person", "label": "tl_id, manager_id", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one", "toOptional": true, "identifying": false },
    { "id": "push-person", "from": "push_subscription", "to": "person", "fromCardinality": "many", "fromOptional": true, "toCardinality": "one" },
