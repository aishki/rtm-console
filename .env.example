# RTM Console settings. Copy this file to .env.local and fill it in. Never commit .env.local.
#
# How a line is read:
#   KEY=value      sets the value.
#   KEY=           sets an EMPTY value, which is an error. To leave a setting unset, comment it out.
#   # KEY=value    is not set at all. Optional settings may be left like this.
# A variable already set in the shell wins over this file.
#
# The server checks every setting when it starts (lib/env.ts) and stops with one message listing
# every problem. Copied as it is, this file fails that check on purpose: APP_ENV and
# PERSISTENCE_MODE below must be filled in.

# ── Environment ─────────────────────────────────────────────────────────────────────────────────

# Required. Which environment this really is: development, test, staging or production.
# Not NODE_ENV, which every `next build` sets to production. A wrong value can let a deployed
# server keep records only in memory or skip TLS checks; the check refuses that outside
# development and test.
APP_ENV=

# Required. Where records are kept: postgres, or memory (nothing survives a restart).
# memory is refused unless APP_ENV is development or test. For a local database see below.
PERSISTENCE_MODE=

# ── Database (needed when PERSISTENCE_MODE=postgres, and by the npm run db:* commands) ──────────

# Either a full connection string. It ALWAYS wins over the DB_* values below, and one exported in
# the shell wins over this file. Put TLS in DB_SSLMODE, not in the URL (?sslmode= is refused).
# DATABASE_URL=postgres://user:password@host:5432/rtm_console

# ...or the parts, composed into a URL (the password is URL-encoded for you). All four together.
# These match the local Docker database (npm run db:up): local only, never a real password.
# DB_HOST=localhost
# DB_PORT=5435
# DB_NAME=rtm_console
# DB_USER=rtm_local
# DB_PASSWORD=rtm_local_only

# Optional. A PostgreSQL schema to work in (sets search_path), so several people can share one database.
# DB_SCHEMA=

# Optional. TLS to the database. verify-full (the default) checks the server's certificate.
# disable: the local container only (development and test). no-verify: development only; on a PC
# behind TLS inspection use DB_CA_CERT instead. Deployed servers always verify.
# DB_SSLMODE=disable

# Optional. Path to an extra certificate authority, added to the trusted ones (never replacing
# them): the RDS bundle on EC2, or a company's certificate behind TLS inspection.
# DB_CA_CERT=/etc/ssl/certs/rds-global-bundle.pem

# Optional. Connections in the pool (default 10). Keep it under the role's connection limit.
# DB_POOL_MAX=10

# Optional. Database for integration tests. Unset: <schema>_test if DB_SCHEMA is set, otherwise
# <database>_test (rtm_console_test in the local container). Tests refuse anything not named *_test.
# TEST_DATABASE_URL=

# ── Floor and access ────────────────────────────────────────────────────────────────────────────

# Feed adapter the server starts on. "sim" runs the floor simulator; anything else uses the
# Gencloud adapter. An admin can switch between the two from the context bar while the
# server runs, in dev and production builds alike.
NEXT_PUBLIC_FEED=sim

# Password for the wall in front of the whole console. While unset, nobody can get in.
# At least 8 characters. Quote it: in an unquoted value, # starts a comment. Never commit the real one.
# RTM_SITE_PASSWORD="..."

# Dev/admin flag ("1" or "0"): enables the "View as" role selector. In production the role and
# span come from the SSO session instead.
NEXT_PUBLIC_VIEW_AS=1

# Shows the dev bar (notification switches) in a production build too ("1" or "0"). It always shows
# in `next dev`. Read at build time: set it on the host, then rebuild and redeploy.
NEXT_PUBLIC_DEV_TOOLS=1

# Secret for /admin/token, where an admin pastes a fresh Genesys token while the server runs.
# At least 16 random characters. The page refuses every request while this is unset.
# RTM_ADMIN_SECRET=

# The floor's time zone (shift clock, start of "today", midnight rollover). Default America/New_York.
# RTM_TIME_ZONE=America/New_York

# ── Genesys Cloud ───────────────────────────────────────────────────────────────────────────────

# Live Gencloud adapter. NEXT_PUBLIC_FEED must be set to something other than "sim"
# (e.g. "gencloud") for these to take effect. Never commit a real token.
# These are Anthem Commercial's. The orgs (and their regions) are in lib/orgs.ts; an Admin switches
# between them from the dev bar and pastes each org's token on /admin/token.
# GENESYS_TOKEN=
# Anthem GBD's and Anthem Specialty's tokens (Genesys US West), the same way.
# GBD_TOKEN=
# SPECIALTY_TOKEN=
# GENCLOUD_API_BASE=https://api.mypurecloud.com
# RTM_VIEW_CONFIG_ID=9c9f8fd2-acab-4282-9442-ddba152f9c18

# OAuth client for running unattended. Both or neither. The secret lives in Secrets Manager in
# deployed environments; never commit it.
# GENCLOUD_CLIENT_ID=
# GENCLOUD_CLIENT_SECRET=

# ── Desktop alerts ──────────────────────────────────────────────────────────────────────────────

# Web Push, so nudges and escalations reach people whose browser is minimized or closed.
# All three or none. Generate a pair with `npx web-push generate-vapid-keys`. Without them,
# alerts only show while a console tab is open. Never commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:someone@your-domain

# ── AWS ─────────────────────────────────────────────────────────────────────────────────────────

# Leave these unset on EC2: the app uses the instance profile. Explicit keys are for local work
# only: the access key ID and secret together, plus the session token for a temporary (ASIA…) key.
# Never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
