# Feed adapter the server starts on. "sim" runs the dev-only floor simulator (ignored in
# production builds). Anything else uses the Gencloud adapter. In dev an admin can switch
# between the two from the context bar while the server runs.
NEXT_PUBLIC_FEED=sim

# Dev/admin flag: enables the "View as" role selector. In production the role and
# span come from the SSO session instead.
NEXT_PUBLIC_VIEW_AS=1

# Live Gencloud adapter. NEXT_PUBLIC_FEED must be set to something other than "sim"
# (e.g. "gencloud") for these to take effect. Never commit a real token.
# GENESYS_TOKEN=
# GENCLOUD_API_BASE=https://api.mypurecloud.com
# RTM_VIEW_CONFIG_ID=9c9f8fd2-acab-4282-9442-ddba152f9c18

# Desktop alerts (Web Push), so nudges and escalations reach people whose browser is
# minimized or closed. Generate a pair with `npx web-push generate-vapid-keys`. Without
# them, alerts only show while a console tab is open. Never commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:someone@your-domain
