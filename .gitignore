# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files: only the example is committed
!.env.example

# design handoff: internal reference material, kept local
/design_handoff_rtm_console

# real floor exports: internal queue names and IDs, never commit
/GenCloudOverall

# reference material used for the docs design, not ours to publish
/docs/vrs-admin-manual.pdf

# real roster (team and agent names) cached for the simulator, never commit
/.rtm

# design system build output (see tools/design-system)
/.design-system
