{
  "name": "rtm-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "kysely migrate:latest --no-outdated-check",
    "db:make": "kysely migrate:make --no-outdated-check",
    "db:status": "kysely migrate:list --no-outdated-check",
    "db:rollback": "tsx tools/db/local-only.ts && kysely migrate:down --no-outdated-check",
    "db:types": "tsx tools/db/types.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "kysely": "0.29.6",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "archify": "^0.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "kysely-codegen": "0.20.0",
    "kysely-ctl": "0.21.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
